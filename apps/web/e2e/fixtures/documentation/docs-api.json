{
  "openapi": "3.0.3",
  "info": {
    "title": "Docs Demo API",
    "version": "3.2.1",
    "description": "A specification used by the Milestone 13 documentation E2E suite."
  },
  "servers": [{ "url": "http://localhost:4010", "description": "Mock server" }],
  "tags": [
    { "name": "Invoices", "description": "Invoice lifecycle." },
    { "name": "Accounts", "description": "Account records." }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/__docs/invoices": {
      "get": {
        "tags": ["Invoices"],
        "operationId": "listInvoices",
        "summary": "List invoices",
        "description": "Returns every invoice visible to the caller.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "description": "Filter by invoice state.",
            "required": false,
            "schema": { "type": "string", "enum": ["draft", "sent", "paid"], "default": "sent" },
            "example": "paid"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum invoices returned.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 250 }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of invoices.",
            "headers": {
              "X-Total-Count": {
                "description": "Total invoices matching the filter.",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Invoice" } },
                "example": [{ "id": "inv-1", "amount": 120.5, "state": "paid" }]
              }
            }
          },
          "401": { "description": "Authentication required." }
        }
      },
      "post": {
        "tags": ["Invoices"],
        "operationId": "createInvoice",
        "summary": "Create an invoice",
        "description": "Creates a draft invoice.",
        "requestBody": {
          "required": true,
          "description": "The invoice to create.",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Invoice" },
              "example": { "amount": 120.5, "state": "draft" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } }
            }
          }
        }
      }
    },
    "/__docs/invoices/{invoiceId}": {
      "parameters": [
        {
          "name": "invoiceId",
          "in": "path",
          "required": true,
          "description": "The invoice identifier.",
          "schema": { "type": "string" }
        }
      ],
      "delete": {
        "tags": ["Invoices"],
        "operationId": "deleteInvoice",
        "summary": "Delete an invoice",
        "deprecated": true,
        "security": [],
        "responses": { "204": { "description": "Deleted." } }
      },
      "head": {
        "tags": ["Invoices"],
        "summary": "Check an invoice exists",
        "responses": { "200": { "description": "It exists." } }
      }
    },
    "/__docs/accounts": {
      "get": {
        "tags": ["Accounts"],
        "operationId": "listAccounts",
        "summary": "List accounts",
        "responses": {
          "200": {
            "description": "Accounts.",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Account" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A signed JWT issued by the accounts service."
      },
      "tenantKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Tenant-Key",
        "description": "Identifies the calling tenant."
      }
    },
    "schemas": {
      "Invoice": {
        "type": "object",
        "required": ["id", "amount"],
        "properties": {
          "id": { "type": "string", "description": "Invoice identifier." },
          "amount": { "type": "number", "format": "double", "minimum": 0 },
          "state": { "type": "string", "enum": ["draft", "sent", "paid"] },
          "note": { "type": "string", "nullable": true },
          "account": { "$ref": "#/components/schemas/Account" }
        }
      },
      "Account": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "billingAddress": { "$ref": "#/components/schemas/Address" },
          "parent": { "$ref": "#/components/schemas/Account" }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" }
        }
      }
    }
  }
}
