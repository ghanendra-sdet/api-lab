{
  "openapi": "3.0.3",
  "info": {
    "title": "Security Fixtures API",
    "version": "1.0.0",
    "description": "Describes the mock server's Milestone 12 security fixtures. The declared constraints match validateFixtureBody() in apps/mock-server/src/securityFixtures.ts exactly — contract-aware negative testing is only meaningful when the specification and the server agree."
  },
  "servers": [{ "url": "http://localhost:4010" }],
  "paths": {
    "/__security/validation": {
      "post": {
        "operationId": "createValidatedUser",
        "summary": "Validation fixture",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/NewUser" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/__security/auth-required": {
      "get": {
        "operationId": "getProtectedResource",
        "summary": "Authentication fixture",
        "responses": {
          "200": { "description": "OK" },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/__security/sensitive-response": {
      "get": {
        "operationId": "getSensitiveResource",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/__security/verbose-error": {
      "get": {
        "operationId": "getVerboseError",
        "responses": { "500": { "description": "Server error" } }
      }
    },
    "/__security/security-headers": {
      "get": {
        "operationId": "getSecurityHeaders",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/__security/cors": {
      "get": {
        "operationId": "getCorsFixture",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "schemas": {
      "NewUser": {
        "type": "object",
        "required": ["name", "age"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 50 },
          "age": { "type": "integer", "minimum": 18, "maximum": 120 },
          "role": { "type": "string", "enum": ["admin", "user"] }
        }
      }
    }
  }
}
