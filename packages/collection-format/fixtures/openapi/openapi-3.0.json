{
  "openapi": "3.0.3",
  "info": { "title": "Pet Store", "description": "A sample API" },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "paths": {
    "/pets": {
      "get": {
        "summary": "List pets",
        "tags": ["Pets"],
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "example": 20 }
        ],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "summary": "Create pet",
        "tags": ["Pets"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": { "name": "Rex", "tag": "dog" }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Get pet by ID",
        "tags": ["Pets"],
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "example": "123" },
          { "name": "X-Request-Id", "in": "header", "required": false }
        ],
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    }
  }
}
